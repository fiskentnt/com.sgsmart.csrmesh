    "local"
  ],
  "name": {
    "en": "SG LEDDim",
    "no": "SG LEDDim"
  },
  "description": {
    "en": "SG Smart dimmers, plugs and thermostats, without a gateway.",
    "no": "Dimmere, plugger og termostater fra SG Smart, uten gateway."
  },
  "category": [
    "lights"
  ],
  "permissions": [
    "homey:wireless:ble"
  ],
  "brandColor": "#E30613",
