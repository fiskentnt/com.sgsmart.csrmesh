  },
  "contributors": {
    "developers": [
      {
        "name": "Trond"
      },
      {
        "name": "nkaminski (csrmesh, the CSRmesh protocol this app follows)"
      },
      {
        "name": "fromm1990 (found that SG's dimmers are ordinary CSRmesh)"
      },
      {
        "name": "einaros (decoded the protocol in 2020)"
      },
      {
        "name": "erlwes (brought the CSRmesh finding to Home Assistant)"
      },
      {
        "name": "Fredrik Karlsen (ha-sg-smart-mesh, the SG Smart 3.0 protocol)"
      },
      {
        "name": "David Simon (ha-bluetooth-mesh, the Bluetooth Mesh stack ha-sg-smart-mesh builds on)"
      },
      {
        "name": "shejnowicz (homey-ble-mesh, Bluetooth Mesh for Homey)"
      }
    ]
  },
  "support": "https://github.com/fiskentnt/com.sgsmart.csrmesh/issues",
  "homeyCommunityTopicId": 159464,
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "source": "https://github.com/fiskentnt/com.sgsmart.csrmesh",
  "homepage": "https://github.com/fiskentnt/com.sgsmart.csrmesh",
  "bugs": {
    "url": "https://github.com/fiskentnt/com.sgsmart.csrmesh/issues"
  },
  "api": {
    "getLogView": {
      "method": "GET",
      "path": "/log-view"
    },
    "getAccount": {
      "method": "GET",
      "path": "/account"
    },
    "loginAccount": {
      "method": "POST",
      "path": "/account/login"
    },
    "forgetAccount": {
      "method": "POST",
      "path": "/account/forget"
    }
  }
