  "flow": {
    "triggers": [
      {
        "id": "plug_countdown_done",
        "title": {
          "en": "The countdown is done",
          "no": "Nedtellingen er ferdig"
        },
        "hint": {
          "en": "When a countdown started in Homey is up, and the plug has been sent off.",
          "no": "Når en nedtelling startet i Homey er ute, og pluggen har fått beskjed om å slå seg av."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sg_plug"
          }
        ]
      },
      {
        "id": "measure_temperature.floor_changed",
        "title": {
          "en": "The floor temperature changed",
          "no": "Gulvtemperaturen endret seg"
        },
        "tokens": [
          {
            "name": "measure_temperature.floor",
            "type": "number",
            "title": {
              "en": "Floor temperature",
              "no": "Gulvtemperatur"
            },
            "example": 24
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sg_thermostat"
          }
        ]
      },
      {
        "id": "sg_heat_preset_changed",
        "title": {
          "en": "The preset changed",
          "no": "Forhåndsinnstillingen ble endret"
        },
        "tokens": [
          {
            "name": "sg_heat_preset",
            "type": "string",
            "title": {
              "en": "Preset",
              "no": "Forhåndsinnstilling"
            },
            "example": "comfort"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sg_thermostat"
          }
        ]
      },
      {
        "id": "sg_heating_true",
        "title": {
          "en": "Started heating",
          "no": "Begynte å varme"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sg_thermostat"
          }
        ]
      },
      {
        "id": "sg_heating_false",
        "title": {
          "en": "Stopped heating",
          "no": "Sluttet å varme"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sg_thermostat"
          }
        ]
      },
      {
        "id": "sg_window_open_true",
        "title": {
          "en": "The open window function started",
          "no": "Åpent vindu-funksjonen slo inn"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sg_thermostat"
          }
        ]
      },
      {
        "id": "sg_window_open_false",
        "title": {
          "en": "The open window function ended",
          "no": "Åpent vindu-funksjonen er ferdig"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sg_thermostat"
          }
        ]
      },
      {
        "id": "sg_floor_limit_true",
        "title": {
          "en": "The floor limit was reached",
          "no": "Gulvgrensen ble nådd"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sg_thermostat"
          }
        ]
      },
      {
        "id": "sg_floor_limit_false",
        "title": {
          "en": "Floor limit no longer reached",
          "no": "Gulvgrensen er ikke lenger nådd"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sg_thermostat"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "plug_countdown_running",
        "title": {
          "en": "The countdown !{{is|is not}} running",
          "no": "Nedtellingen !{{går|går ikke}}"
