{
  "id": "com.sgsmart.csrmesh",
  "version": "1.0.48",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "SG LEDDim",
    "no": "SG LEDDim"
  },
  "description": {
    "en": "Control older SG LEDDim dimmers (Gen1, Bluetooth CSRmesh) from Homey. Unofficial.",
    "no": "Styr eldre SG LEDDim-dimmere (Gen1, Bluetooth CSRmesh) fra Homey. Uoffisiell."
  },
  "category": [
    "lights"
  ],
  "permissions": [
    "homey:wireless:ble"
  ],
  "author": {
    "name": "Community / experimental"
  },
  "drivers": [
    {
      "id": "sg_sofa",
      "name": {
        "en": "Stue sofa",
        "no": "Stue sofa"
      },
      "class": "light",
      "capabilities": [
        "onoff",
        "dim"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "ble"
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true,
            "title": {
              "en": "Stue sofa",
              "no": "Stue sofa"
            }
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices",
          "options": {
            "title": {
              "en": "Add Stue sofa",
              "no": "Legg til Stue sofa"
            }
          }
        }
      ],
      "settings": [
        {
          "id": "pin",
          "type": "text",
          "label": {
            "en": "CSRmesh PIN",
            "no": "CSRmesh-PIN"
          },
          "value": "1234",
          "hint": {
            "en": "Usually 1234 on SG Smart installations.",
            "no": "Vanligvis 1234 på SG Smart-installasjoner."
          }
        },
        {
          "id": "passphrase",
          "type": "text",
          "value": "",
          "label": {
            "en": "Network passphrase",
            "no": "Nettverkspassphrase"
          },
          "hint": {
            "en": "CSRmesh network passphrase from the SG app. Overrides PIN when set.",
            "no": "CSRmesh nettverkspassphrase fra SG-appen. Overstyrer PIN når den er satt."
          }
        },
        {
          "id": "netkey_hex",
          "type": "text",
          "value": "",
          "label": {
            "en": "Raw network key (hex)",
            "no": "Rå nettverksnøkkel (hex)"
          },
          "hint": {
            "en": "32 hex chars = 16-byte CSRmesh network key. Overrides everything else.",
            "no": "32 hex-tegn = 16-byte CSRmesh nettverksnøkkel. Overstyrer alt annet."
          }
        },
        {
          "id": "object_id",
          "type": "number",
          "label": {
            "en": "Object / group ID",
            "no": "Objekt-/gruppe-ID"
          },
          "value": 0,
          "hint": {
            "en": "0 = broadcast, positive = device ID, negative = group ID.",
            "no": "0 = broadcast, positiv = enhets-ID, negativ = gruppe-ID."
          }
        },
        {
          "id": "repeats",
          "type": "number",
          "value": 1,
          "label": {
            "en": "Repeats per command",
            "no": "Gjentakelser per kommando"
          },
          "hint": {
            "en": "How many times each command is retransmitted (mesh is lossy).",
            "no": "Hvor mange ganger hver kommando sendes på nytt (meshet mister pakker)."
          }
        }
      ],
      "images": {
        "small": "/drivers/sg_sofa/assets/images/small.png",
        "large": "/drivers/sg_sofa/assets/images/large.png"
      }
    },
